# ===================================================
# Environment Configuration Template
# ===================================================
# Copy this file to .env.local for local development.
# Copy this file to .env.production for production.
# NEVER commit .env.local or .env.production to git.
# ===================================================

# ---- Database (Phase 1) ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myproject
DB_USERNAME=postgres
DB_PASSWORD=password

# ---- pgAdmin (Phase 1) ----
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# ---- JWT ----
JWT_SECRET=replace_me_with_a_secure_secret_at_least_256_bits
JWT_EXPIRATION_MS=86400000

# ---- Application ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ==============================================================================
# Phase 2 — Redis (uncomment when adding caching)
# ==============================================================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ==============================================================================
# Phase 3 — MinIO (uncomment when adding file uploads)
# ==============================================================================
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=myproject

# ==============================================================================
# Phase 4 — RabbitMQ (uncomment when adding async jobs)
# ==============================================================================
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest

# ==============================================================================
# Phase 5 — Mail (uncomment when implementing email features)
# ==============================================================================
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
