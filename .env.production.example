# Example production environment file used by the Azure VM deployment workflow.
# Copy to .env.production on the deployment host and fill in values.

BACKEND_IMAGE=ghcr.io/your-org/your-repo/backend:sha-<commit-sha>
FRONTEND_IMAGE=ghcr.io/your-org/your-repo/frontend:sha-<commit-sha>
DB_HOST=postgres
DB_PORT=5432
DB_NAME=myproject
DB_USERNAME=postgres
DB_PASSWORD=change-me
JWT_SECRET=change-me
