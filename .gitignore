# ===== Build Artifacts =====
target/
*.class
*.jar
*.war

# ===== Maven =====
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ===== Node.js =====
node_modules/
dist/
build/
.cache/
*.tsbuildinfo

# ===== Environment =====
# Local and production secrets — never commit these
.env
.env.local
.env.production
# .env.example is intentionally committed as a template

# ===== IDE =====
.idea/
*.iml
*.iws
*.ipr
.project
.classpath
.factorypath
.settings/
*.swp
*.swo
*~

# ===== OS =====
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ===== Logs =====
*.log
logs/

# ===== Docker =====
docker-compose.override.yml

# ===== Backups =====
backups/

# ===== SSH Keys & Credentials =====
# NEVER commit private keys
*.pem
*.key
id_rsa
id_ed25519

# ===== Misc =====
*.bak
*.tmp
*.temp
.terraform/
*.tfstate
*.tfstate.backup
